generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id          String   @id @default(cuid())
  description String
  status      String   @default("pending")
  result      Json?
  totalCost   Decimal?
  spendCap    Decimal?
  events      Json?    @default("[]")
  walletAddress String?
  requestedSpecialistId      String?
  requestedSpecialistName    String?
  requestedAgentVersionId    String?
  requestedAgentVersionHash  String?
  approvalStatus     String   @default("pending")
  approvedAt         DateTime?
  approvedByWallet   String?
  approvalResultHash String?
  ownerId     String?
  // ── v3 tenancy (additive) — null = legacy/unscoped task ─────────────────────
  projectId   String?
  // agentId: the project Specialist chosen via the SDK gateway (/api/v1/executions).
  // Linkage only — the coordinator routes normally; null = legacy/console task.
  agentId     String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  subtasks     Subtask[]
  payments     Payment[]
  jobs         Job[]
  traceEvents  ExecutionTraceEvent[]
  receipt      ExecutionReceipt?
  escrow       Escrow?
  proofs       Proof[]
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([agentId])
}

model Subtask {
  id             String   @id @default(cuid())
  taskId         String
  capability     String
  specialistId   String?
  specialistName String?
  status         String   @default("pending")
  cost           Decimal?
  result         String?
  agentVersionId String?
  parentSubtaskId String?
  delegatedBySpecialistName String?
  delegationDepth Int      @default(0)
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  task         Task          @relation(fields: [taskId], references: [id])
  specialist   Specialist?   @relation(fields: [specialistId], references: [id])
  agentVersion AgentVersion? @relation(fields: [agentVersionId], references: [id])
}

model Specialist {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String
  endpoint       String
  walletAddress  String
  capabilities   String[]
  priceUsdc      Decimal
  reputation     Int      @default(50)
  totalJobs      Int      @default(0)
  status         String   @default("online")
  aiModel        String?  @default("openai")
  apiKey         String?
  apiKeyMasked   String?
  ownerId        String?
  /// ProofPolicy: "trace-only" | "receipt-proof" | "escrow-eligible"
  proofPolicy    String   @default("trace-only")
  currentVersion Int      @default(1)
  // ── v3 tenancy (additive) ──────────────────────────────────────────────────
  // projectId: null = system/global agent (legacy + demo). Set when deployed via SDK.
  projectId      String?
  /// AgentType: "blend_yield" | "soroswap_trading" | "aquarius_liquidity" | "anchor_payment" | null = LLM specialist
  agentType      String?
  // config: SDK agent envelope { name, settings } for project-scoped agents created
  // via /api/v1/agents. The `name` column stays a globally-unique internal sentinel
  // (discovery upserts by name); the developer-facing name lives in config.name.
  config         Json?
  createdAt      DateTime @default(now())

  subtasks Subtask[]
  payments Payment[]
  versions AgentVersion[]
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Payment {
  id           String   @id @default(cuid())
  taskId       String
  specialistId String
  amount       Decimal
  currency     String   @default("USDC")
  txHash       String?
  blockNumber  Int?
  fromAddress  String?
  toAddress    String?
  status       String   @default("pending")
  protocol     String   @default("trustless_work")
  createdAt    DateTime @default(now())
  confirmedAt  DateTime?

  task       Task       @relation(fields: [taskId], references: [id])
  specialist Specialist @relation(fields: [specialistId], references: [id])
}

model Reputation {
  id           String   @id @default(cuid())
  specialistId String   @unique
  score        Int      @default(50)
  totalRatings Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/**
 * Immutable snapshot of specialist metadata at publication time.
 *
 * Every time agent price, capabilities, wallet, or proof policy changes,
 * a new version row is created. Subtasks reference the version that was
 * active at invocation so receipts can prove the exact metadata used.
 *
 * versionHash is SHA-256(name|version|price|wallet|capabilities|proofPolicy)
 * computed deterministically so it can be included in receipt hashes.
 */
model AgentVersion {
  id            String   @id @default(cuid())
  specialistId  String
  version       Int
  name          String
  description   String
  walletAddress String
  capabilities  String[]
  priceUsdc     Decimal
  proofPolicy   String
  aiModel       String
  versionHash   String
  createdAt     DateTime @default(now())

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  subtasks   Subtask[]

  @@unique([specialistId, version])
  @@index([specialistId])
}

/**
 * Receipt-backed reputation events.
 *
 * Only verified executions affect the verified stats shown in the marketplace.
 * Demo completions are tracked separately and labeled distinctly in the UI.
 * The score field stores the impact (+1 success, -1 failure) for aggregation.
 */
model ReputationEvent {
  id           String   @id @default(cuid())
  specialistId String
  taskId       String?
  /// EventType: "verified_completion" | "demo_completion" | "failure"
  type         String
  score        Int
  verified     Boolean  @default(false)
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([specialistId])
  @@index([specialistId, verified])
}

/**
 * Structured, hash-chained trace event for a single execution step.
 *
 * Every meaningful coordinator action (routing, payment, specialist execution,
 * lifecycle transitions) is recorded as a trace event. Events are chained via
 * prevEventHash so the final eventHash of the last event serves as the trace
 * root — any mutation to an earlier event changes all subsequent hashes.
 *
 * eventHash = SHA-256(taskId | sequence | eventType | actor | inputHash |
 *                     outputHash | prevEventHash)
 */
model ExecutionTraceEvent {
  id            String   @id @default(cuid())
  taskId        String
  sequence      Int
  /// TraceEventType: coordinator_start | task_decomposed | spend_cap_check |
  ///   spend_cap_exceeded | specialist_assigned | payment_initiated |
  ///   payment_confirmed | payment_failed | specialist_invoked |
  ///   specialist_completed | specialist_failed | task_completed | task_failed
  eventType     String
  actor         String
  displayMessage String
  inputHash     String?
  outputHash    String?
  eventHash     String
  prevEventHash String?
  metadata      Json?
  timestamp     DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, sequence])
  @@index([taskId])
}

/**
 * Canonical receipt for a completed execution.
 *
 * Commits to task input, selected agent version snapshots, spend cap, total
 * cost, the trace root, output summary, and all on-chain payment entries.
 * receiptHash = SHA-256(canonical JSON of the receipt fields).
 *
 * The receipt is the artifact that downstream proof and escrow systems consume.
 * status starts as "proof_ready" once all trace events exist.
 */
model ExecutionReceipt {
  id                 String   @id @default(cuid())
  taskId             String   @unique
  taskInputHash      String
  agentVersionHashes String[]
  spendCap           Decimal?
  totalCost          Decimal?
  traceRoot          String
  outputHash         String?
  registrySnapshotHash String?
  anchorContractId   String?
  anchorTxHash       String?
  anchoredAt         DateTime?
  /// AnchorStatus: "pending" | "anchored" | "failed" — Soroban receipt anchoring (additive)
  anchorStatus       String?
  /// Blend operation display metadata { protocol, operation, asset, amount, poolId, txHash, apy }.
  /// Additive + NOT part of receiptHash (commitment rides on traceRoot). Sprint 7B.
  blendOperation     Json?
  paymentSummary     Json
  receiptHash        String
  /// ReceiptStatus: "pending" | "proof_ready" | "verified"
  status             String   @default("proof_ready")
  createdAt          DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

/**
 * Durable job boundary for long-running background work.
 *
 * A Job wraps a single unit of background execution (coordinator run, proof
 * generation, escrow sync) and survives process restarts. Status transitions:
 *   queued → running → completed
 *                    ↘ failed (retried up to maxAttempts)
 *
 * Atomic claiming: UPDATE WHERE status='queued' prevents double-execution
 * when two processes race to start the same job.
 */
model Job {
  id          String    @id @default(cuid())
  /// JobType: "coordinator_execution" | "proof_generation" | "escrow_sync"
  type        String
  /// JobStatus: "queued" | "running" | "completed" | "failed"
  status      String    @default("queued")
  taskId      String?
  payload     Json
  result      Json?
  errorMsg    String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([status, type])
}

/**
 * Top-level escrow record for a task execution.
 *
 * Created after spend cap passes when ESCROW_MODE != "disabled".
 * externalId is the Trustless Work escrow ID (null in demo mode uses DEMO- prefix).
 * Each subtask maps to one EscrowMilestone.
 *
 * EscrowStatus: pending | funding_pending | funding_failed | funded | in_progress | completed | cancelled | disputed
 */
model Escrow {
  id             String    @id @default(cuid())
  taskId         String    @unique
  externalId     String?
  /// EscrowStatus: pending | funding_pending | funding_failed | funded | in_progress | completed | cancelled | disputed
  status         String    @default("pending")
  totalAmount    Decimal
  currency       String    @default("USDC")
  payerAddress   String
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  task       Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  milestones EscrowMilestone[]

  @@index([taskId])
  @@index([status])
}

/**
 * One milestone per specialist subtask.
 *
 * releaseCondition controls what gate must pass before releaseMilestone() is called:
 *   proof_verified — requires ExecutionReceipt.status === "verified"
 *   receipt_ready  — requires ExecutionReceipt to exist
 *   manual         — coordinator triggers release explicitly
 *   auto           — released immediately after specialist completes (demo)
 *
 * MilestoneStatus: pending | funded | in_progress | released | refunded | failed
 */
model EscrowMilestone {
  id                   String    @id @default(cuid())
  escrowId             String
  subtaskId            String?
  specialistId         String
  recipientAddress     String
  amount               Decimal
  /// MilestoneStatus: pending | funded | in_progress | released | refunded | failed
  status               String    @default("pending")
  /// ReleaseCondition: proof_verified | user_approved | proof_and_user_approved | receipt_ready | manual | auto
  releaseCondition     String    @default("auto")
  agentVersionId       String?
  agentVersionHash     String?
  receiptId            String?
  releaseTxHash        String?
  externalMilestoneId  String?
  metadata             Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  escrow Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId])
  @@index([status])
  @@index([subtaskId])
}

/**
 * Proof record for a completed execution receipt.
 *
 * Tracks the lifecycle of a proof job: queued by receipt service, run by
 * the deterministic TypeScript verifier (local) or Boundless/RISC Zero (live).
 *
 * ProofStatus: pending | running | proven | verified | failed
 *
 * journal is the ProofJournal JSON produced by the verifier — 5 boolean
 * constraints that a verifier can check without re-running the full trace.
 */
model Proof {
  id            String    @id @default(cuid())
  receiptId     String    @unique
  taskId        String
  receiptHash   String
  schemaVersion String    @default("1.0")
  /// ProofStatus: pending | running | proven | verified | failed
  status        String    @default("pending")
  programId     String?
  journal       Json?
  artifactUri   String?
  errorMsg      String?
  createdAt     DateTime  @default(now())
  provenAt      DateTime?
  verifiedAt    DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([receiptId])
  @@index([status])
}

// ── v3 Identity & Tenancy (Phase 1, additive) ────────────────────────────────

/**
 * Developer account. Owns one or more Projects.
 *
 * passwordHash format: "scrypt:<saltHex>:<hashHex>" (see lib/password.ts).
 * Raw passwords are never stored or logged.
 */
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects     Project[]
  sessions     Session[]
}

/**
 * Server-side session. The raw token lives only in the httpOnly cookie
 * (asn_session); the DB stores sha256(rawToken) as tokenHash for lookup.
 * Sessions are revocable (delete row) and expire at expiresAt.
 */
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/**
 * A developer's project — one product/application. Owns its API keys, AI
 * provider BYOK config, agents, and tasks. All execution data is project-scoped.
 *
 * aiApiKeyEncrypted is AES-256-GCM ciphertext (iv:authTag:ciphertext) of the
 * developer's provider key. Only aiApiKeyMasked is ever returned to clients.
 */
model Project {
  id                String   @id @default(cuid())
  userId            String
  name              String
  description       String?
  /// Network: "testnet" | "mainnet" — drives API key prefix (vx_test_ / vx_live_)
  network           String   @default("testnet")
  /// AIProvider: "openai" | "anthropic" | "groq" | "kimi"
  aiProvider        String   @default("anthropic")
  aiApiKeyEncrypted String?
  aiApiKeyMasked    String?
  webhookUrl        String?
  webhookSecret     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys ProjectApiKey[]
  agents  Specialist[]
  tasks   Task[]

  @@index([userId])
}

/**
 * Verix project API key (vx_live_... / vx_test_...).
 *
 * Only sha256(rawKey) is stored (keyHash). The raw key is shown exactly once at
 * creation. keyPrefix + last4 are non-secret display fields. Revoked keys keep
 * their row (revokedAt set) for audit and never resolve at lookup.
 *
 * NOTE: generation/lookup helpers land in Sprint 2 — this model is additive now.
 */
model ProjectApiKey {
  id          String    @id @default(cuid())
  projectId   String
  keyHash     String    @unique
  keyPrefix   String
  last4       String
  /// "live" | "test" — derived from project.network at creation.
  environment String
  label       String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/**
 * Durable wallet-signing request (Beta Phase 1).
 *
 * When a project agent runs in wallet signing mode, the engine builds an unsigned
 * XDR and the execution PAUSES (Task.status = "awaiting_signature"). This row
 * persists everything needed to resume after the user signs: the unsigned XDR,
 * signing mode, source wallet, expiry, and a `context` blob (protocol op +
 * receipt-synthesis snapshot). Additive — never part of any receipt/proof hash.
 *
 * status: "awaiting_signature" | "resuming" | "resolved" | "expired" | "failed"
 */
model ExecutionSignatureRequest {
  id           String    @id @default(cuid())
  taskId       String    @unique
  projectId    String
  signingMode  String     @default("wallet")
  sourceWallet String
  unsignedXdr  String
  status       String     @default("awaiting_signature")
  txHash       String?
  /// Resume context: { blend: {...op}, synth: {...receipt inputs} }
  context      Json
  resumedAt    DateTime?
  createdAt    DateTime   @default(now())
  expiresAt    DateTime

  @@index([projectId])
  @@index([status])
}
